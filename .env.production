# Production environment variables (used at build time by Vite)
# The API base URL as seen by the browser (nginx strips /kanbanBoard/ before reaching Node)
VITE_API_URL=/kanbanBoard
# Gemini key for Smart Extract in import modal
VITE_GEMINI_API_KEY=
# Optional: override Gemini model used by Smart Extract
VITE_GEMINI_MODEL=gemini-2.5-flash
